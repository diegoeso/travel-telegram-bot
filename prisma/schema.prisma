generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model activities {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id          BigInt    @db.UnsignedBigInt
  title            String?   @db.VarChar(255)
  description      String?   @db.Text
  activitable_type String    @db.VarChar(255)
  activitable_id   BigInt    @db.UnsignedBigInt
  deleted_at       DateTime? @db.Timestamp(0)
  created_at       DateTime? @db.Timestamp(0)
  updated_at       DateTime? @db.Timestamp(0)

  @@index([activitable_type, activitable_id], map: "activities_activitable_type_activitable_id_index")
}

model additional_services {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model addresses {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  street           String?   @db.VarChar(254)
  number_int       String?   @db.VarChar(10)
  number_ext       String?   @db.VarChar(10)
  colony           String?   @db.VarChar(255)
  city             String?   @db.VarChar(255)
  state            String?   @db.VarChar(255)
  country          String?   @default("México") @db.VarChar(255)
  zip_code         String?   @db.VarChar(255)
  zipcode_id       Int?
  addressable_type String    @db.VarChar(255)
  addressable_id   BigInt    @db.UnsignedBigInt
  created_at       DateTime? @db.Timestamp(0)
  updated_at       DateTime? @db.Timestamp(0)

  @@index([addressable_type, addressable_id], map: "addresses_addressable_type_addressable_id_index")
}

model agendas {
  id             BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  user_id        BigInt         @db.UnsignedBigInt
  title          String         @db.VarChar(255)
  description    String?        @db.Text
  type           agendas_type   @default(call)
  start_at       DateTime       @db.DateTime(0)
  end_at         DateTime?      @db.DateTime(0)
  status         agendas_status @default(pending)
  reminder       Boolean        @default(false)
  agendable_type String?        @db.VarChar(255)
  agendable_id   BigInt?        @db.UnsignedBigInt
  created_at     DateTime?      @db.Timestamp(0)
  updated_at     DateTime?      @db.Timestamp(0)
  users          users          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "agendas_user_id_foreign")

  @@index([agendable_type, agendable_id], map: "agendas_agendable_type_agendable_id_index")
  @@index([user_id], map: "agendas_user_id_foreign")
}

model agreements {
  id                BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  company_id        BigInt?           @db.UnsignedBigInt
  user_id           BigInt?           @db.UnsignedBigInt
  title             String            @db.VarChar(255)
  description       String?           @db.Text
  welcome           String?           @db.Text
  code              String            @unique(map: "agreements_code_unique") @db.VarChar(255)
  discount          Decimal           @default(0.00) @db.Decimal(5, 2)
  start_date        DateTime          @db.Date
  end_date          DateTime?         @db.Date
  status            agreements_status @default(Active)
  is_active         Boolean           @default(true)
  web_link          String            @unique(map: "agreements_web_link_unique") @db.VarChar(255)
  web_link_name     String            @unique(map: "agreements_web_link_name_unique") @db.VarChar(255)
  logo              String?           @db.VarChar(255)
  banner            String?           @db.VarChar(255)
  web_visit         Int?
  aditional_info    String?           @db.Text
  terms_conditions  String?           @db.Text
  agreement_file    String?           @db.VarChar(255)
  payment_method_id Int?
  qr_code           String?           @db.VarChar(255)
  deleted_at        DateTime?         @db.Timestamp(0)
  created_at        DateTime?         @db.Timestamp(0)
  updated_at        DateTime?         @db.Timestamp(0)
}

model banks {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name          String    @db.VarChar(255)
  code          String    @default("000") @db.VarChar(255)
  ignore_serfin Boolean   @default(false)
  created_at    DateTime? @db.Timestamp(0)
  updated_at    DateTime? @db.Timestamp(0)
}

model booking_orders {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  booking_id BigInt?   @db.UnsignedBigInt
  order_id   BigInt?   @db.UnsignedBigInt
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model booking_rooms {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  booking_id BigInt?   @db.UnsignedBigInt
  room_id    BigInt?   @db.UnsignedBigInt
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model bookings {
  id                      BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  order_id                BigInt?   @db.UnsignedBigInt
  user_id                 BigInt?   @db.UnsignedBigInt
  package_type_id         BigInt?   @db.UnsignedBigInt
  destination_id          BigInt?   @db.UnsignedBigInt
  hotel_id                BigInt?   @db.UnsignedBigInt
  customer_name           String?   @db.VarChar(255)
  customer_email          String?   @db.VarChar(255)
  customer_phone          String?   @db.VarChar(255)
  check_in_date           DateTime? @db.Date
  check_out_date          DateTime? @db.Date
  check_in                DateTime? @db.Time(0)
  check_out               DateTime? @db.Time(0)
  adults                  Int       @default(2)
  kids                    Int       @default(0)
  juniors                 Int       @default(0)
  status_id               Int       @default(1)
  payment_status_id       Int       @default(1)
  total_amount            Decimal   @default(0.00) @db.Decimal(10, 2)
  paid_amount             Decimal   @default(0.00) @db.Decimal(10, 2)
  balance_to_pay          Decimal   @default(0.00) @db.Decimal(10, 2)
  special_requests        String?   @db.Text
  cancellation_policy     String?   @db.VarChar(255)
  source                  String    @default("system") @db.VarChar(255)
  currency                String    @default("MXN") @db.VarChar(3)
  nights                  Int       @default(2)
  days                    Int       @default(3)
  created_by              Int?
  assigned_by             Int?
  cancellation_date       DateTime? @db.Date
  reason_for_cancellation String?   @db.Text
  booking_reference       String?   @db.VarChar(255)
  confirmation_voucher    String?   @db.VarChar(255)
  confirmation_number     String?   @db.VarChar(255)
  nom_rooms               Int       @default(1)
  type                    Int       @default(1)
  deleted_at              DateTime? @db.Timestamp(0)
  created_at              DateTime? @db.Timestamp(0)
  updated_at              DateTime? @db.Timestamp(0)
  guests                  guests[]

  @@index([assigned_by], map: "bookings_assigned_by_index")
  @@index([booking_reference], map: "bookings_booking_reference_index")
  @@index([confirmation_number], map: "bookings_confirmation_number_index")
  @@index([created_at], map: "bookings_created_at_index")
  @@index([check_in_date, check_out_date], map: "bookings_dates_index")
  @@index([destination_id], map: "bookings_destination_id_index")
  @@index([hotel_id], map: "bookings_hotel_id_index")
  @@index([status_id, created_at], map: "bookings_status_created_index")
  @@index([status_id], map: "bookings_status_id_index")
  @@index([user_id], map: "bookings_user_id_index")
  @@fulltext([customer_name, customer_email, customer_phone, booking_reference, confirmation_number], map: "bookings_search_fulltext")
}

model calls {
  id            BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  contact_name  String       @db.VarChar(255)
  phone         String       @db.VarChar(255)
  scheduled     DateTime     @db.Date
  start         DateTime?    @db.Time(0)
  end           DateTime?    @db.Time(0)
  notes         String?      @db.Text
  status        calls_status @default(Pending)
  created_by    BigInt       @db.UnsignedBigInt
  callable_id   BigInt?      @db.UnsignedBigInt
  callable_type String?      @db.VarChar(255)
  deleted_at    DateTime?    @db.Timestamp(0)
  created_at    DateTime?    @db.Timestamp(0)
  updated_at    DateTime?    @db.Timestamp(0)
}

model campaigns {
  id             BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  agreement_id   Int?
  package_id     Int?
  name           String?                 @db.VarChar(255)
  description    String?                 @db.Text
  discount_type  campaigns_discount_type @default(percentage)
  discount_value Decimal                 @default(0.00) @db.Decimal(8, 2)
  start_date     DateTime                @db.DateTime(0)
  end_date       DateTime                @db.DateTime(0)
  status         campaigns_status        @default(active)
  banner         String?                 @db.VarChar(255)
  web_link       String?                 @db.VarChar(255)
  type_campaign  campaigns_type_campaign @default(internal)
  created_at     DateTime?               @db.Timestamp(0)
  updated_at     DateTime?               @db.Timestamp(0)
}

model cards {
  id                 BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  user_id            Int
  bank_id            Int?
  holder_name        String?            @db.VarChar(255)
  number             String             @db.VarChar(20)
  year_expire        String?            @db.VarChar(4)
  month_expire       String?            @db.VarChar(2)
  cvv                String             @default("000") @db.VarChar(4)
  red                cards_red          @default(Visa)
  type               cards_type         @default(Debit)
  type_account       cards_type_account @default(dbgenerated("03"))
  is_default         Int?               @db.TinyInt
  status             Int?               @db.UnsignedTinyInt
  status_description String?            @db.Text
  gateway            String?            @db.VarChar(255)
  token_id           String?            @db.VarChar(255)
  created_by         Int?
  deleted_at         DateTime?          @db.Timestamp(0)
  created_at         DateTime?          @db.Timestamp(0)
  updated_at         DateTime?          @db.Timestamp(0)
}

model catalog_booking_statuses {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name        String    @unique(map: "catalog_booking_statuses_name_unique") @db.VarChar(255)
  description String?   @db.VarChar(255)
  color       String    @default("#fff020") @db.VarChar(255)
  is_active   Boolean   @default(true)
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
}

model catalog_booking_types {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name        String?   @db.VarChar(100)
  description String?   @db.Text
  slug        String?   @db.VarChar(100)
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
}

model catalog_company_status {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name        String    @db.VarChar(255)
  description String?   @db.VarChar(255)
  color       String?   @db.VarChar(255)
  is_active   Boolean   @default(true)
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
}

model catalog_order_status {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name        String?   @db.VarChar(255)
  description String?   @db.VarChar(255)
  color       String?   @db.VarChar(255)
  editable    Boolean   @default(false)
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
}

model catalog_payment_method {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name        String    @db.VarChar(255)
  description String?   @db.VarChar(255)
  color       String?   @db.VarChar(255)
  is_active   Boolean   @default(true)
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
}

model catalog_payment_statuses {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  key         String    @unique(map: "catalog_payment_statuses_key_unique") @db.VarChar(255)
  name        String    @db.VarChar(255)
  color       String?   @db.VarChar(255)
  icon        String?   @db.VarChar(255)
  description String?   @db.Text
  editable    Boolean   @default(false)
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
}

model chart_role {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  chart_id   BigInt    @db.UnsignedBigInt
  role_id    BigInt    @db.UnsignedBigInt
  is_default Boolean   @default(false)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  charts     charts    @relation(fields: [chart_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "chart_role_chart_id_foreign")
  roles      roles     @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "chart_role_role_id_foreign")

  @@unique([chart_id, role_id], map: "chart_role_chart_id_role_id_unique")
  @@index([role_id], map: "chart_role_role_id_foreign")
}

model charts {
  id          BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  name        String       @db.VarChar(255)
  slug        String       @unique(map: "charts_slug_unique") @db.VarChar(255)
  key         String       @unique(map: "charts_key_unique") @db.VarChar(255)
  description String?      @db.Text
  type        String       @default("line") @db.VarChar(255)
  category    String?      @db.VarChar(255)
  icon        String?      @db.VarChar(255)
  color       String       @default("primary") @db.VarChar(255)
  component   String?      @db.VarChar(255)
  config      Json?
  order       Int          @default(0)
  is_active   Boolean      @default(true)
  created_at  DateTime?    @db.Timestamp(0)
  updated_at  DateTime?    @db.Timestamp(0)
  chart_role  chart_role[]
}

model codigo_postals {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  codigo_postal String    @db.VarChar(6)
  asenta        String    @db.VarChar(100)
  tipo_asenta   String    @db.VarChar(100)
  municipio     String    @db.VarChar(100)
  estado        String    @db.VarChar(100)
  ciudad        String    @db.VarChar(100)
  created_at    DateTime? @db.Timestamp(0)
  updated_at    DateTime? @db.Timestamp(0)

  @@index([codigo_postal], map: "codigo_postals_codigo_postal_index")
}

model companies {
  id                BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id           BigInt    @db.UnsignedBigInt
  name              String    @db.VarChar(255)
  business          String?   @db.VarChar(255)
  business_name     String?   @db.VarChar(255)
  rfc               String?   @db.VarChar(255)
  web_page          String?   @db.VarChar(255)
  branches          String?   @db.Text
  category          String?   @default("1") @db.VarChar(255)
  corporate         Boolean?  @default(false)
  use_logo          Boolean?  @default(false)
  use_social        Boolean?  @default(false)
  payment_method_id BigInt?   @db.UnsignedBigInt
  sales_strategy    String?   @db.Text
  status_id         BigInt?   @default(1) @db.UnsignedBigInt
  contact           String?   @db.VarChar(255)
  position          String?   @db.VarChar(255)
  phone             String?   @db.VarChar(255)
  email             String?   @db.VarChar(255)
  assistant         String?   @db.VarChar(255)
  assistant_phone   String?   @db.VarChar(255)
  assistant_email   String?   @db.VarChar(255)
  logo              String?   @db.VarChar(255)
  comments          String?   @db.Text
  facebook          String?   @db.VarChar(255)
  twitter           String?   @db.VarChar(255)
  instagram         String?   @db.VarChar(255)
  linkedin          String?   @db.VarChar(255)
  deleted_at        DateTime? @db.Timestamp(0)
  created_at        DateTime? @db.Timestamp(0)
  updated_at        DateTime? @db.Timestamp(0)
}

model contracts {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name       String    @db.VarChar(255)
  template   String    @db.VarChar(255)
  content    String    @db.VarChar(255)
  is_active  Boolean   @default(true)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model destinations {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name        String    @db.VarChar(255)
  description String?   @db.Text
  location    String    @db.VarChar(255)
  image       String?   @db.VarChar(255)
  status      Boolean   @default(true)
  slug        String    @unique(map: "destinations_slug_unique") @db.VarChar(255)
  deleted_at  DateTime? @db.Timestamp(0)
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
}

model failed_jobs {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid       String   @unique(map: "failed_jobs_uuid_unique") @db.VarChar(255)
  connection String   @db.Text
  queue      String   @db.Text
  payload    String   @db.LongText
  exception  String   @db.LongText
  failed_at  DateTime @default(now()) @db.Timestamp(0)
}

model guests {
  id              BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  booking_id      BigInt       @db.UnsignedBigInt
  room_id         BigInt?      @db.UnsignedBigInt
  first_name      String       @db.VarChar(255)
  last_name       String       @db.VarChar(255)
  document_type   String?      @db.VarChar(255)
  document_number String?      @db.VarChar(255)
  birth_date      DateTime?    @db.Date
  type            guests_type?
  is_main_guest   Boolean      @default(false)
  created_at      DateTime?    @db.Timestamp(0)
  updated_at      DateTime?    @db.Timestamp(0)
  bookings        bookings     @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "guests_booking_id_foreign")
  rooms           rooms?       @relation(fields: [room_id], references: [id], onUpdate: NoAction, map: "guests_room_id_foreign")

  @@index([booking_id], map: "guests_booking_id_foreign")
  @@index([room_id], map: "guests_room_id_foreign")
}

model hotels {
  id                  BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  destination_id      BigInt?   @db.UnsignedBigInt
  name                String    @db.VarChar(255)
  category            String    @db.VarChar(255)
  description         String?   @db.Text
  latitude            Decimal?  @db.Decimal(10, 7)
  longitude           Decimal?  @db.Decimal(10, 7)
  contact_name        String?   @db.VarChar(255)
  phone               String?   @db.VarChar(255)
  email               String?   @db.VarChar(255)
  website             String?   @db.VarChar(255)
  stars               Int       @default(3)
  facilities          Json?
  policies            Json?
  check_in_time       DateTime  @db.Time(0)
  check_out_time      DateTime  @db.Time(0)
  allows_pets         Boolean   @default(false)
  cancellation_policy String?   @db.Text
  price_per_night     Decimal   @db.Decimal(10, 2)
  currency            String    @db.VarChar(3)
  payment_methods     Json?
  availability        Json?
  featured_image      String?   @db.VarChar(255)
  status              Boolean   @default(true)
  deleted_at          DateTime? @db.Timestamp(0)
  created_at          DateTime? @db.Timestamp(0)
  updated_at          DateTime? @db.Timestamp(0)
}

model jobs {
  id           BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  queue        String @db.VarChar(255)
  payload      String @db.LongText
  attempts     Int    @db.UnsignedTinyInt
  reserved_at  Int?   @db.UnsignedInt
  available_at Int    @db.UnsignedInt
  created_at   Int    @db.UnsignedInt

  @@index([queue], map: "jobs_queue_index")
}

model kpi_role {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  kpi_id     BigInt?   @db.UnsignedBigInt
  role_id    BigInt?   @db.UnsignedBigInt
  is_default Boolean   @default(false)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)

  @@unique([kpi_id, role_id], map: "kpi_role_kpi_id_role_id_unique")
}

model kpis {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name        String    @db.VarChar(255)
  slug        String    @unique(map: "kpis_slug_unique") @db.VarChar(255)
  key         String    @unique(map: "kpis_key_unique") @db.VarChar(255)
  description String?   @db.Text
  type        String    @default("numeric") @db.VarChar(255)
  category    String?   @db.VarChar(255)
  icon        String?   @db.VarChar(255)
  color       String    @default("primary") @db.VarChar(255)
  config      Json?
  order       Int       @default(0)
  is_active   Boolean   @default(true)
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
}

model logs {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  old_values    Json?
  new_values    Json?
  action        String    @db.VarChar(255)
  user_id       BigInt?   @db.UnsignedBigInt
  loggable_type String    @db.VarChar(255)
  loggable_id   BigInt    @db.UnsignedBigInt
  created_at    DateTime? @db.Timestamp(0)
  updated_at    DateTime? @db.Timestamp(0)

  @@index([loggable_type, loggable_id], map: "logs_loggable_type_loggable_id_index")
}

model migrations {
  id        Int    @id @default(autoincrement()) @db.UnsignedInt
  migration String @db.VarChar(255)
  batch     Int
}

model notes {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  body          String    @db.Text
  type          String?   @db.VarChar(255)
  user_id       BigInt?   @db.UnsignedBigInt
  is_private    Boolean   @default(false)
  noteable_type String?   @db.VarChar(255)
  noteable_id   BigInt?   @db.UnsignedBigInt
  deleted_at    DateTime? @db.Timestamp(0)
  created_at    DateTime? @db.Timestamp(0)
  updated_at    DateTime? @db.Timestamp(0)

  @@index([noteable_type, noteable_id], map: "notes_noteable_type_noteable_id_index")
}

model notification_preferences {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt    @db.UnsignedBigInt
  type       String    @db.VarChar(255)
  enabled    Boolean   @default(true)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "notification_preferences_user_id_foreign")

  @@unique([user_id, type], map: "notification_preferences_user_id_type_unique")
}

model notifications {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt    @db.UnsignedBigInt
  title      String    @db.VarChar(255)
  message    String    @db.Text
  type       String    @db.VarChar(255)
  is_read    Boolean   @default(false)
  link       String?   @default("0") @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "notifications_user_id_foreign")

  @@index([user_id], map: "notifications_user_id_foreign")
